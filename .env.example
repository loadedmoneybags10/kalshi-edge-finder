# Environment variables for the live deploy (set these in Vercel → Settings →
# Environment Variables). Do NOT commit real values — this file is a template.

# The Odds API key (books: Pinnacle/DraftKings/FanDuel). Get one at the-odds-api.com.
ODDS_API_KEY=your_odds_api_key_here

# Feed mode — how the pipeline sources data:
#   mock — everything simulated (no keys needed); good for a UI demo.
#   sim  — REAL book odds + REAL final scores (The Odds API) + a SIMULATED Kalshi
#          price. Paper plays are placed on real upcoming games and graded on
#          real results. This is the recommended mode until real Kalshi is wired:
#          real odds, real outcomes, no real money, Kalshi execution modeled.
#   live — real books + real Kalshi (pending series-ticker discovery).
FEED=sim
# (Legacy: USE_MOCK=0 with no FEED set is treated as sim.)

# SIM tuning — the modeled Kalshi underpricing that creates edges (probability
# points). Higher = more plays (more optimistic). Defaults shown.
# SIM_EDGE=0.07
# SIM_WIDTH=0.09

# ---- Odds API credit control (free tier is ~500 credits/month) ----
# Cost per odds call = (#markets × #regions). Default requests 3 markets in 1
# region = 3 credits/call. Set to "h2h" for moneyline/winner only (1 credit/call)
# to roughly third the burn. The poller also (a) skips out-of-season leagues via
# a FREE /sports check and (b) caches each league's odds in state so the cron's
# close+poll and repeat polls within ODDS_TTL_MIN share ONE paid fetch.
# ODDS_MARKETS=h2h,totals,spreads
# ODDS_TTL_MIN=360

# Kalshi market-data host (public prices, no auth). Override only if the host
# moves — the discovery probe accepts ?base= to test an alternate.
# KALSHI_BASE=https://api.elections.kalshi.com/trade-api/v2

# Storage: "kv" for production (Vercel KV). "file" is dev-only and does NOT
# persist on Vercel (serverless is ephemeral) — production MUST use kv.
STORE=kv

# Auto-injected by Vercel when you add a KV / Upstash store — do not set by hand:
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
