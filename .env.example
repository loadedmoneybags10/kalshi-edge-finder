# Environment variables for the live deploy (set these in Vercel → Settings →
# Environment Variables). Do NOT commit real values — this file is a template.

# The Odds API key (books: Pinnacle/DraftKings/FanDuel). Get one at the-odds-api.com.
ODDS_API_KEY=your_odds_api_key_here

# Turn OFF mock mode so the feed uses real data.
USE_MOCK=0

# Kalshi market-data host (public prices, no auth). Override only if the host
# moves — the discovery probe accepts ?base= to test an alternate.
# KALSHI_BASE=https://api.elections.kalshi.com/trade-api/v2

# Storage: "kv" for production (Vercel KV). "file" is dev-only and does NOT
# persist on Vercel (serverless is ephemeral) — production MUST use kv.
STORE=kv

# Auto-injected by Vercel when you add a KV / Upstash store — do not set by hand:
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
