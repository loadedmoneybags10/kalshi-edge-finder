{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cron.mjs":  { "memory": 256, "maxDuration": 60 },
    "api/poll.mjs":  { "memory": 256, "maxDuration": 30 },
    "api/grade.mjs": { "memory": 256, "maxDuration": 30 },
    "api/close.mjs": { "memory": 256, "maxDuration": 30 },
    "api/state.mjs": { "memory": 256, "maxDuration": 10 },
    "api/discover.mjs": { "memory": 256, "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/", "destination": "/edge/dashboard-standalone.html" },
    { "source": "/demo", "destination": "/edge/dashboard-demo.html" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 12 * * *" }
  ]
}
